# =============================================================================
#  .env de la pila de observabilidad — HelpDesk Lite   (PLANTILLA)
#
#  Vive en /opt/helpdesk/observability/.env, junto a compose.observability.yml.
#  NO son secretos de GitHub Actions: esta pila se levanta a mano en el
#  servidor y el pipeline no la toca.
#
#      mkdir -p /opt/helpdesk/observability
#      cd /opt/helpdesk/observability
#      # copiar aquí compose.observability.yml y config/
#      cp env-observabilidad.example .env && chmod 600 .env
#      # rellenar los valores de abajo
#      docker compose -f compose.observability.yml up -d
#
#  ESTE FICHERO SE VERSIONA: no pongas aquí ningún valor real. El fichero con
#  los valores operativos ya generados es `env-observabilidad.txt`, que no se
#  sube al repositorio.
# =============================================================================

# ---------- Grafana ------------------------------------------------------------
# Sin valor, el contenedor NO arranca (compose lo declara con `:?`). Es
# deliberado: un Grafana con la contraseña por defecto es un panel de control
# de la infraestructura abierto a quien encuentre el puerto.
# Generar con: openssl rand -base64 24
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Sólo cambia si publicas Grafana por Nginx Proxy Manager con una Access List.
# Mientras se llegue por túnel SSH (ssh -L 3000:127.0.0.1:3000), déjalo así.
GRAFANA_ROOT_URL=http://localhost:3000

# ---------- Destinatario de las alertas -----------------------------------------
# Alertmanager necesita un buzón real y un SMTP CON AUTENTICACIÓN: es un
# servicio distinto de la API y no comparte la limitación de mail.service.ts.
# Brevo tiene plan gratuito de 300 correos/día (SMTP & API -> Generate SMTP key).
#
# Los cuatro son OBLIGATORIOS para que Alertmanager arranque. Si falta alguno,
# el contenedor `alertmanager-config` aborta con un mensaje diciendo cuál, y
# Alertmanager no se levanta — el resto de la pila sí. Es a propósito: una
# alerta que no llega a nadie es peor que no tener alertas.
ALERT_EMAIL_TO=
ALERT_SMTP_HOST=smtp-relay.brevo.com:587
ALERT_SMTP_USER=
ALERT_SMTP_PASS=
# Remitente. Brevo sólo entrega si es un remitente VALIDADO (Senders → Add
# sender → enlace de confirmación) o un dominio AUTENTICADO (Domains → añadir
# helpdesklite.me → registros DKIM/DMARC/brevo-code en Cloudflare DNS). Sin
# eso acepta el correo (250) y lo bloquea después. Por defecto:
# ALERT_SMTP_FROM=HelpDesk Lite Alertas <alertas@helpdesklite.me>

# Opcional: Telegram para las críticas, que es lo que de verdad se mira fuera
# del horario. Con las dos variables presentes el renderizador deja el bloque
# telegram_configs de config/alertmanager/alertmanager.yml.tmpl; si falta
# alguna, lo quita y sólo hay correo. No hay que tocar la plantilla.
# ALERT_TELEGRAM_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=

# ---------- Credenciales de sólo lectura para los exportadores -------------------
# MISMOS VALORES que los secretos PROD_* / STAGING_* de GitHub Actions, que son
# también los que el despliegue escribe en /opt/helpdesk/<entorno>/.env.
# Si rotas uno en GitHub, cámbialo también aquí o el exportador deja de
# conectar y Grafana se queda sin métricas de PostgreSQL.
#
# Comprobación: `curl -s 127.0.0.1:9187/metrics | grep '^pg_up'` -> pg_up 1
#
# postgres-exporter sólo hace SELECT sobre pg_stat_*; cuando tengáis el usuario
# sin privilegios (informe §4.3.b), usad ése aquí en vez del propietario.
PROD_DB_USER=
PROD_DB_PASSWORD=
PROD_DB_NAME=helpdesk_prod

STAGING_DB_USER=
STAGING_DB_PASSWORD=
STAGING_DB_NAME=helpdesk_staging
