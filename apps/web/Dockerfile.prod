# ==========================================
# ETAPA 1: BUILDER (El Cocinero)
# ==========================================
FROM node:24-alpine@sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43 AS builder

WORKDIR /app

# 1. Copiamos los manifiestos
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY packages/contracts/package.json packages/contracts/package.json

# 2. Instalamos TODAS las dependencias (necesitamos Vite para compilar)
RUN npm ci

# 3. Copiamos el código fuente
COPY packages/ packages/
COPY apps/web/ apps/web/
COPY tsconfig.base.json ./

WORKDIR /app/apps/web

# 4. Vite compila el código y genera la carpeta 'dist'
RUN npm run build

# Nota: ¡Aquí NO hacemos npm prune! La Etapa 2 no necesita node_modules.

# ==========================================
# ETAPA 2: PRODUCCIÓN (El Camarero - Nginx)
# ==========================================
FROM nginx:1.31-alpine AS production

# 1. Limpiamos la página por defecto de Nginx
RUN rm -rf /usr/share/nginx/html/*

# Copiar la configuración del proxy interno y SPA
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY apps/web/proxy-common.inc /etc/nginx/conf.d/proxy-common.inc
COPY apps/web/security-headers.inc /etc/nginx/conf.d/security-headers.inc
# Puertas de la documentación. Estas copias son las INOFENSIVAS (auth_basic off
# y cabecera vacía); en el servidor se montan encima las reales, que llevan el
# secreto. Así la imagen no contiene ninguna credencial y, si alguien la
# ejecuta suelta, la API sigue negando la documentación por su propia cuenta.
COPY apps/web/docs-auth.inc /etc/nginx/conf.d/docs-auth.inc
COPY apps/web/docs-gateway.inc /etc/nginx/conf.d/docs-gateway.inc
# El fichero de contraseñas se monta en /run/docs y este script lo coloca en
# /etc/nginx con el dueño que necesitan los procesos de trabajo. Sin él, un
# .htpasswd 600 del usuario del despliegue es ilegible para el uid 101 y Nginx
# contesta 500. No lleva ningún secreto dentro: sólo mueve el que se monta.
COPY --chmod=0755 apps/web/docker-entrypoint.d/40-docs-auth.sh /docker-entrypoint.d/40-docs-auth.sh

# Copiar los archivos compilados de Vite
# 2. Robamos SOLO la carpeta compilada de la Etapa 1
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# 3. Exponemos el puerto estándar de web
EXPOSE 80

# 4. Arrancamos Nginx
CMD ["nginx", "-g", "daemon off;"]
