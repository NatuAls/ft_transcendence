# =============================================================================
#  HelpDesk Lite — plantilla de entorno
#  Copiar a .env  ->  `cp .env.example .env`
#  NUNCA subir .env. Todos los valores de aquí son ejemplos.
#
#  CAMBIO IMPORTANTE respecto a la versión anterior: este fichero documentaba
#  SÓLO el entorno de desarrollo (POSTGRES_USER, DATABASE_URL…), mientras que
#  compose.prod.yml espera otros nombres (DB_USER, DB_PASSWORD, DB_NAME,
#  ENV_NAME, GHCR_OWNER, GITHUB_SHA). Quien leyera este fichero para preparar
#  el servidor se encontraba con que la mitad de las variables no existían.
#  Ahora están las dos secciones, separadas y etiquetadas.
#
#  El evaluador comprueba explícitamente que existe .env.example y que .env
#  está en .gitignore (proceso de evaluación → Technical Requirements →
#  Environment Variables). Que sea COMPLETO y COHERENTE es lo que convierte
#  ese punto en un sí sin discusión.
# =============================================================================

NODE_ENV=development

# =============================================================================
#  A) DESARROLLO LOCAL  —  lo lee compose.dev.yml
# =============================================================================

# ---------- Base de datos -----------------------------------------------------
POSTGRES_USER=mi_usuario
POSTGRES_PASSWORD=change_me
POSTGRES_DB=mi_base_datos
DATABASE_URL=postgresql://mi_usuario:change_me@db:5432/mi_base_datos?schema=public

# Orígenes del navegador autorizados a enviar peticiones con credenciales,
# separados por comas. Sin barra final (env.ts la quita igualmente).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Caché y tiempo real -----------------------------------------------
REDIS_URL=redis://redis:6379

# ---------- Seguridad ----------------------------------------------------------
# Mínimo 32 caracteres. Generar con: openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_at_least_32_characters_long
# Declarado por paridad con la aplicación de referencia; hoy no se usa (los
# refresh tokens son bytes aleatorios opacos, no JWT). Aun así, generarlo
# DISTINTO del anterior: el día que se use, reutilizarlo sería un fallo.
JWT_REFRESH_SECRET=change_me_at_least_32_characters_long_too
# Mínimo 16 caracteres. Cambiarlo invalida TODAS las contraseñas existentes.
PASSWORD_PEPPER=change_me_at_least_16_chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ---------- Correo (Mailpit, incluido en compose.dev.yml) ----------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM="HelpDesk Lite <no-reply@helpdesk.local>"

# ---------- Adjuntos -----------------------------------------------------------
UPLOAD_DIR=/var/lib/helpdesk/uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_PER_TICKET=5

# ---------- Rate limiting ------------------------------------------------------
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_AUTH_PER_MIN=10
API_KEY_RATE_PER_MIN=60
API_KEY_RATE_PER_HOUR=1000

# ---------- Operación ----------------------------------------------------------
LOG_LEVEL=info
SEED_ON_BOOT=true

# NUEVO (tarea 9). Token de operación: habilita GET /api/metrics para
# Prometheus y la vista detallada de /api/health/status y /api/version.
# Si se deja vacío, /api/metrics responde 404 y la página de estado sólo
# devuelve el semáforo público, sin nombres de dependencias ni latencias.
# Generar con: openssl rand -hex 32. Lo rellena scripts/gen-secrets.sh.
METRICS_TOKEN=

# Primer administrador (auditoría §6.3). Si no existe ningún GLOBAL_ADMIN, el
# arranque promociona al usuario ya registrado con este correo, y lo anota en
# audit_logs. No crea cuentas ni contraseñas. Vacío = no hace nada. En el
# servidor lo inyecta el pipeline desde la variable *_BOOTSTRAP_ADMIN_EMAIL.
BOOTSTRAP_ADMIN_EMAIL=

# =============================================================================
#  B) SERVIDOR (staging y producción)  —  lo lee compose.prod.yml
#
#  Este fichero NO se edita a mano en el servidor: lo REESCRIBE ENTERO
#  scripts/deploy/remote-deploy.sh en cada despliegue, con permisos 600, a
#  partir de los secretos y variables de GitHub Actions. Esta sección está
#  aquí para documentar qué contiene y para poder levantar la pila de
#  producción en local si hace falta depurar.
# =============================================================================

# ---------- Identidad del despliegue -------------------------------------------
# staging | prod. Da nombre a contenedores, volúmenes y red.
ENV_NAME=prod
# Propietario del repositorio en GHCR, en minúsculas.
GHCR_OWNER=natuals
# SHA del commit desplegado. Es la etiqueta de las imágenes y el destino del
# rollback: el script lo lee del .env anterior antes de sobrescribirlo.
GITHUB_SHA=0000000000000000000000000000000000000000
APP_VERSION=main-1

# ---------- Base de datos del servidor -----------------------------------------
# Ojo: nombres DISTINTOS a los de desarrollo. compose.prod.yml construye
# DATABASE_URL a partir de estos tres, así que DATABASE_URL no se declara aquí.
DB_USER=helpdesk
DB_PASSWORD=change_me_generado_con_openssl
DB_NAME=helpdesk

# ---------- Orígenes permitidos -------------------------------------------------
# OBLIGATORIA. Si está vacía el despliegue se detiene con un mensaje explícito.
CORS_ORIGINS=https://helpdesklite.me

# ---------- Correo real ---------------------------------------------------------
# Mailpit no existe en el servidor: dejarlo así hace que /api/health/ready
# marque el correo como degradado (no bloquea) y que los correos no salgan.
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM="HelpDesk Lite <no-reply@helpdesklite.me>"

# ---------- Copias de seguridad (tarea 8) ---------------------------------------
BACKUP_RETENTION_DAYS=14
# OBLIGATORIA con backup.sh v2. Sin ella el servicio `backup` no arranca.
# Cifra el dump y los adjuntos con AES-256. Guardarla en los secretos de
# GitHub (STAGING_BACKUP_KEY / PROD_BACKUP_KEY) **y** en el gestor de
# contraseñas del equipo: si se pierde, las copias son ruido irrecuperable.
# Generar con: openssl rand -hex 48   (hexadecimal, no base64: es alfanumérico
# puro y sobrevive a un copia-pega a un `docker run -e` o a un YAML sin
# comillas. Con 48 bytes la entropía sobra de largo.)
# Lo rellena automáticamente scripts/gen-secrets.sh.
BACKUP_ENCRYPTION_KEY=

# Destino FUERA del host, formato de rclone: "<remoto>:<bucket>/<ruta>".
# Vacío = la copia se queda sólo en la instancia, y perder la instancia
# significa perder a la vez los datos y las copias.
# Ejemplo con Oracle Object Storage (endpoint S3-compatible, incluido en la
# capa gratuita) o Backblaze B2:
#   RCLONE_REMOTE=objectstorage:helpdesk-backups/prod
#
# ES EL ÚNICO VALOR QUE gen-secrets.sh NO PUEDE GENERAR: depende de un bucket
# que hay que crear y de unas credenciales que emite la consola de Oracle.
# Pasos exactos, con comandos:  bash scripts/gen-secrets.sh --rclone-help
RCLONE_REMOTE=

# ---------- Observabilidad (tarea 9) ---------------------------------------------
METRICS_TOKEN=
LOG_LEVEL=info
