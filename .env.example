# =============================================================================
#  HelpDesk Lite - environment template
#  Copy to .env  ->  `cp .env.example .env`
#  NEVER commit .env. Values below are examples only.
# =============================================================================

NODE_ENV=development

# ---------- Database ----------------------------------------------------------
POSTGRES_USER=mi_usuario
POSTGRES_PASSWORD=change_me
POSTGRES_DB=mi_base_datos
DATABASE_URL=postgresql://mi_usuario:change_me@db:5432/mi_base_datos?schema=public

# Comma-separated browser origins allowed to send credentialed API requests.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Cache / realtime --------------------------------------------------
REDIS_URL=redis://redis:6379

# ---------- Security ------------------------------------------------------------
# Must be >= 32 characters.
JWT_ACCESS_SECRET=change_me_at_least_32_characters_long
# Declared for parity with the reference app; currently unused (refresh tokens
# are opaque random bytes, not JWTs).
JWT_REFRESH_SECRET=change_me_at_least_32_characters_long
# Must be >= 16 characters.
PASSWORD_PEPPER=change_me_at_least_16_chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ---------- Mail (Mailpit, bundled in docker-compose) --------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM="HelpDesk Lite <no-reply@helpdesk.local>"

# ---------- Uploads --------------------------------------------------------------
UPLOAD_DIR=/var/lib/helpdesk/uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_PER_TICKET=5

# ---------- Rate limiting ---------------------------------------------------------
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_AUTH_PER_MIN=10
API_KEY_RATE_PER_MIN=60
API_KEY_RATE_PER_HOUR=1000

# ---------- Operations -------------------------------------------------------------
LOG_LEVEL=info
SEED_ON_BOOT=true
